        "jsCode": "const data = ($input.first() && $input.first().json) || {};\nconst info = ((data.stages || {})['download']) || {};\nconst stageStatus = String(info.status || '').toLowerCase();\nconst jobStatus = String(data.status || '').toLowerCase();\n\nreturn [{\n  json: {\n    ...data,\n    stage: 'download',\n    stage_status: stageStatus,\n    stage_done: stageStatus === 'done',\n    stage_failed:\n      stageStatus === 'failed' ||\n      stageStatus === 'cancelled' ||\n      jobStatus === 'failed' ||\n      jobStatus === 'cancelled',\n    stage_error: String(info.error || data.error || ''),\n  },\n}];"
